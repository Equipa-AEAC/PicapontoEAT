{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Vite App",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build & Test hxwell Server (cpp)",
      "type": "shell",
      "command": "haxelib run hxwell test cpp",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}